# DWH Studio environment template.
# Copy to `.env` (git-ignored) or `.env.dev` / `.env.test` / `.env.prod` and replace every CHANGE_ME.
# Never commit the real file. Values below are placeholders, not working credentials.

# ---------------------------------------------------------------------------
# Environment selection, Flask and session
# ---------------------------------------------------------------------------
# Which `.env.<name>` file is loaded on top of `.env`: dev | test | prod.
ENVIRONMENT=dev

# Secret used to sign Flask sessions. Must be at least 32 random characters.
# Placeholders are rejected on network-exposed profiles and required in prod.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=CHANGE_ME

# Host and port the Flask API binds to. Keep 127.0.0.1 for the local-only profile.
APP_HOST=127.0.0.1
APP_PORT=5000
# Public host name and base URL used in generated links.
APP_PUBLIC_HOST=localhost
APP_URL=http://localhost:5000
# Flask debug mode and auto-reloader. Never enable on network-exposed profiles.
APP_DEBUG=false
APP_USE_RELOADER=false

# ---------------------------------------------------------------------------
# Deployment profile and access control
# ---------------------------------------------------------------------------
# One of: local-only | lan-pilot | on-prem-hardened (see docs/deployment-security-profiles.md).
DEPLOYMENT_PROFILE=local-only
# Set true when the app terminates TLS itself.
APP_TLS_ENABLED=false
# Set true when a reverse proxy in front of the app terminates TLS.
APP_REVERSE_PROXY_TLS_ENABLED=false
# Comma-separated client IP allowlist, for example 10.0.0.5,10.0.0.6. Empty means not configured.
APP_IP_ALLOWLIST=
# Comma-separated allowed browser origins, for example https://dwh.example.internal. Empty means not configured.
APP_ALLOWED_ORIGINS=
# Enable the built-in login. Required on network-exposed profiles.
APP_AUTH_ENABLED=false
# Login user name for the built-in login.
APP_AUTH_USERNAME=CHANGE_ME
# Password HASH (not the plain password) for the login user.
APP_AUTH_PASSWORD_HASH=CHANGE_ME
# Role granted to the authenticated user (default: operator).
APP_AUTH_DEFAULT_ROLE=operator
# Session lifetime in minutes.
APP_SESSION_TIMEOUT_MINUTES=480
# File that receives the JSON-lines security audit log.
SECURITY_AUDIT_LOG_FILE=logs/security_audit.jsonl

# ---------------------------------------------------------------------------
# Oracle Database connection
# ---------------------------------------------------------------------------
# Read/metadata account used by the app. Use a least-privilege account.
ORACLE_USER=CHANGE_ME
ORACLE_PASSWORD=CHANGE_ME
# Easy Connect string, host:port/service_name.
ORACLE_DSN=localhost:1521/orcl
# Separate account allowed to run approved DDL on the target schema.
ORACLE_DDL_USER=CHANGE_ME
ORACLE_DDL_PASSWORD=CHANGE_ME
# Schema that owns the audit tables (defaults to ORACLE_USER when omitted).
AUDIT_ORACLE_USER=AUDIT_USER

# Source system: oracle (default) or mssql (legacy adapter, requires ENABLE_MSSQL_SOURCE=true).
SOURCE_DB_TYPE=oracle
# Optional overrides; they fall back to the ORACLE_* values above when empty.
SOURCE_ORACLE_USER=
SOURCE_ORACLE_PASSWORD=
SOURCE_ORACLE_DSN=
# Comma-separated source schemas to expose, for example HR,SH. Empty means all accessible schemas.
SOURCE_ORACLE_SCHEMAS=
# Optional target overrides; they fall back to the DDL account when empty.
TARGET_ORACLE_USER=
TARGET_ORACLE_PASSWORD=
TARGET_ORACLE_DSN=
# Comma-separated business schemas shown in the UI.
PROJECT_SCHEMAS=HR,SH,DWH
# Label stored with generated mappings.
SOURCE_SYSTEM_NAME=ORACLE_SAMPLE_SCHEMAS
# Maximum identifier length for generated table names (Oracle 19c allows 128).
TABLE_NAME_MAX_LENGTH=128

# Legacy SQL Server source adapter (disabled by default).
ENABLE_MSSQL_SOURCE=false
MSSQL_SERVER=CHANGE_ME
MSSQL_DATABASE=CHANGE_ME
MSSQL_USER=CHANGE_ME
MSSQL_PASSWORD=CHANGE_ME
# Default SQL Server host pre-filled in the UI, for example sqlserver.example.internal. Optional.
MSSQL_DEFAULT_SERVER=
# Default SQL Server database pre-filled in the UI, for example SalesDb. Optional.
MSSQL_DEFAULT_DATABASE=

# One-time provisioning credentials (setup_oracle_users.py). Use only while provisioning, then remove.
SETUP_ORACLE_SYS_USER=CHANGE_ME
SETUP_ORACLE_SYS_PASSWORD=CHANGE_ME
# Password given to the application accounts the setup script creates.
SETUP_APP_USER_PASSWORD=CHANGE_ME
# Privileged account used by the security-audit and live-test helpers.
ORACLE_SYS_USER=CHANGE_ME
ORACLE_SYS_PASSWORD=CHANGE_ME
# Set true to run tests that need a live database. Leave false normally.
RUN_LIVE_DB_TESTS=false

# ---------------------------------------------------------------------------
# Oracle Data Integrator repository and agent
# ---------------------------------------------------------------------------
# ODI Middleware/Oracle home directory containing the ODI SDK jars.
ODI_HOME=/path/to/Oracle_Home
# Java home used to launch the Groovy automation (JDK 8 for ODI 12c).
JAVA_HOME=/path/to/jdk
# Optional explicit java executable path.
JAVA_EXE=
# Optional semicolon-separated list of java executables to try if JAVA_HOME fails.
JAVA_FALLBACK_PATHS=
# `groovy` drives the ODI SDK; `rest` targets an ODI REST endpoint.
ODI_MODE=groovy
# ODI project and folder that receive generated mappings.
ODI_PROJECT=ORA_DWH
ODI_FOLDER=FLD_CORE_MAPPINGS
# ODI master repository connection.
ODI_REPO_DSN=localhost:1521/orcl
ODI_REPO_SCHEMA=CHANGE_ME
ODI_REPO_USER=CHANGE_ME
ODI_REPO_PASSWORD=CHANGE_ME
# Name of the ODI work repository.
ODI_WORK_REPOSITORY=WORKREP
# Alternative name key for the ODI work repository, read by one helper script.
ODI_WORK_REPO_NAME=WORKREP
# ODI Supervisor (or equivalent) login used by the SDK.
ODI_SUPERVISOR_USER=CHANGE_ME
ODI_SUPERVISOR_PASSWORD=CHANGE_ME
# Paths of the generated odi_connection.properties (see odi_connection.properties.example).
ODI_CONNECTION_PROPERTIES_OUT=odi_automation/odi_connection.properties
ODI_CONNECTION_PROPERTIES=odi_automation/odi_connection.properties
# ODI REST settings, only used when ODI_MODE=rest.
ODI_REST_URL=
ODI_REST_USER=
ODI_REST_PASSWORD=
# File names of the jars you supply yourself from your own ODI installation.
OJDBC_JAR_NAME=ojdbc8.jar
GROOVY_JAR_NAME=groovy-all-2.4.17.jar
# Preferred ODI knowledge modules, comma-separated, first match wins.
ODI_IKM_PRIORITY=oracle merge,oracle update,oracle insert
ODI_LKM_PRIORITY=sql to oracle,mssql to oracle,sql to sql
# Base URL of an optional scheduler UI link.
AIRFLOW_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Provider selection; hybrid is the default.
LLM_PROVIDER=hybrid
# Anthropic API key for the cloud assistant. Leave empty to stay fully local.
ANTHROPIC_API_KEY=CHANGE_ME
# Local Ollama server and model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
# Chat endpoint, format http://host:port/api/chat (derived from OLLAMA_BASE_URL when omitted).
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
# Model list endpoint, format http://host:port/api/tags.
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
# Embeddings endpoint, format http://host:port/api/embeddings.
OLLAMA_EMBEDDINGS_URL=http://localhost:11434/api/embeddings
# Local OpenAI-compatible server (for example LM Studio).
LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
LOCAL_OPENAI_MODEL=qwen/qwen2.5-coder-14b
# API key for that server; many local servers accept any non-empty value.
LOCAL_OPENAI_API_KEY=CHANGE_ME

# Optional HashiCorp Vault lookup for secrets. When false, plain environment values are used.
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=CHANGE_ME
VAULT_KV_MOUNT=secret
VAULT_APP_SECRET_PATH=dwh-studio/dev
VAULT_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------------------
# Paths, logging and monitoring
# ---------------------------------------------------------------------------
# Log verbosity: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Rotating application log file, relative or absolute path, for example logs/app.log.
LOG_FILE=logs/app.log
# Local retrieval-augmented generation stores.
RAG_DB_PATH=./rag_database.json
CHROMA_PERSIST_DIR=./chroma_db
# Alert thresholds: days before data counts as stale, and polling interval in seconds.
ALERT_FRESHNESS_DAYS=2
ALERT_POLL_INTERVAL=60

# ---------------------------------------------------------------------------
# Optional / setup-script variables
# ---------------------------------------------------------------------------
# Base URL the operator smoke check calls, for example http://localhost:5000.
OPERATOR_SMOKE_BASE_URL=http://localhost:5000

# Passwords for the schemas created by setup_oracle_users.py. Use only while provisioning.
# Application user password (alternative name).
APP_USER_PASSWORD=CHANGE_ME
# Audit schema owner password (setup name and runtime name).
SETUP_AUDIT_USER_PASSWORD=CHANGE_ME
AUDIT_USER_PASSWORD=CHANGE_ME
# ODI execution account password (setup name and runtime name).
SETUP_ODI_EXEC_PASSWORD=CHANGE_ME
ODI_EXEC_PASSWORD=CHANGE_ME
# ODS schema owner password (setup name and runtime name).
SETUP_ODS_OWNER_PASSWORD=CHANGE_ME
ODS_OWNER_PASSWORD=CHANGE_ME
# DWH schema owner password (setup name and runtime name).
SETUP_DWH_OWNER_PASSWORD=CHANGE_ME
DWH_OWNER_PASSWORD=CHANGE_ME

# Names tracked by the secret inventory check (values are never printed).
# WebLogic admin password for the ODI domain.
WEBLOGIC_PASSWORD=CHANGE_ME
# Optional Airflow metadata database password.
AIRFLOW_DB_PASSWORD=CHANGE_ME
# Optional Airflow web UI user password.
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME

# Frontend (Vite) development variables; set them in the frontend environment, not the Flask one.
# Dev server port, for example 5173.
VITE_DEV_PORT=5173
# Backend URL the dev server proxies API calls to, for example http://localhost:5000.
VITE_API_PROXY_TARGET=http://localhost:5000
# Local OpenAI-compatible server URL shown in the UI, for example http://localhost:1234/v1.
VITE_LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
# Scheduler UI link shown in the UI, for example http://localhost:8080.
VITE_AIRFLOW_URL=http://localhost:8080
